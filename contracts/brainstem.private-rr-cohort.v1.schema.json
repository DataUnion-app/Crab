{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://brainstem.dataunion.app/contracts/brainstem.private-rr-cohort.v1.schema.json",
  "title": "Brainstem private R-R cohort v1",
  "description": "The fixed identifier-minimized input produced by Crab for approved resting R-R compute jobs.",
  "$comment": "Crab additionally enforces canonical JSON, a 16 MiB body limit, unique subjectId values, source hashes, current consent, and job-scoped HMAC generation.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "policy", "participants"],
  "properties": {
    "schema": { "const": "brainstem.private-rr-cohort/v1" },
    "policy": { "const": "brainstem.resting-rr/v1" },
    "participants": {
      "type": "array",
      "maxItems": 1000,
      "items": { "$ref": "#/$defs/participant" }
    }
  },
  "$defs": {
    "participant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["subjectId", "recordings"],
      "properties": {
        "subjectId": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "recordings": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": { "$ref": "#/$defs/recording" }
        }
      }
    },
    "recording": {
      "type": "object",
      "additionalProperties": false,
      "required": ["recordingType", "durationSeconds", "rrIntervalsMs"],
      "properties": {
        "recordingType": { "const": "rest" },
        "durationSeconds": {
          "type": "integer",
          "minimum": 300,
          "maximum": 86400
        },
        "rrIntervalsMs": {
          "type": "array",
          "minItems": 4,
          "maxItems": 3600,
          "items": {
            "type": "number",
            "minimum": 250,
            "maximum": 2000
          }
        }
      }
    }
  }
}
